---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  thumbnail?: boolean;
}

const { src, alt, thumbnail = false } = Astro.props;
---

<photo-image class:list={{ thumbnail }}>
  <span class="placeholder" aria-hidden="true">photo is downloading; plz be patient</span>
  <Image
    src={src}
    alt={alt}
    width={Math.min(src.width, thumbnail ? 320 : 1280)}
    widths={thumbnail ? [240, 320, 480, 640] : [640, 960, 1280, 1920]}
    sizes={thumbnail
      ? '(max-width: 393px) calc(100vw - 50px), (max-width: 571px) calc((100vw - 62px) / 2), (max-width: 688px) calc((100vw - 74px) / 3), 205px'
      : '(max-width: 688px) calc(100vw - 50px), 638px'}
    format="webp"
    quality={thumbnail ? 65 : 85}
    loading={thumbnail ? 'lazy' : 'eager'}
    fetchpriority={thumbnail ? 'auto' : 'high'}
  />
</photo-image>

<script>
  class PhotoImage extends HTMLElement {
    connectedCallback() {
      const img = this.querySelector('img');
      const placeholder = this.querySelector<HTMLElement>('.placeholder');
      if (!img || !placeholder) return;

      const loaded = () => {
        placeholder.hidden = true;
      };
      const failed = () => {
        placeholder.textContent = 'photo could not be downloaded; plz try refreshing';
        placeholder.hidden = false;
      };

      img.addEventListener('load', loaded, { once: true });
      img.addEventListener('error', failed, { once: true });
      // Cached images may finish before this component is initialized.
      if (img.complete) {
        if (img.naturalWidth > 0) loaded();
        else failed();
      }
    }
  }

  if (!customElements.get('photo-image')) {
    customElements.define('photo-image', PhotoImage);
  }
</script>

<style>
  photo-image {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }
  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
    font: 400 12px/1.6 var(--mono);
    color: var(--mut);
  }
  .placeholder[hidden] {
    display: none;
  }
  img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .thumbnail img {
    position: absolute;
    inset: 0;
    object-fit: cover;
  }
</style>

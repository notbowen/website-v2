---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    // Posts are newest-first, so "prev" is the newer post and "next" the older one.
    props: { post, prev: posts[i - 1] ?? null, next: posts[i + 1] ?? null },
  }));
}

interface Props {
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.excerpt} here="blog">
  <main class="post-page">
    <a class="back" href="/blog">← all posts</a>

    <article>
      <div class="meta">
        <time datetime={post.dateIso}>{post.dateFull}</time> · {post.readTime}
      </div>
      <h1>{post.data.title}</h1>
      <div class:list={['tags', { none: post.data.tags.length === 0 }]}>
        {
          post.data.tags.map((t) => (
            <a class="tag" href={`/blog?tag=${encodeURIComponent(t)}`}>
              {t}
            </a>
          ))
        }
      </div>

      <p class="lede">{post.lede}</p>

      <div class="prose">
        <Content />
      </div>
    </article>

    {
      (prev || next) && (
        <nav class="pager" aria-label="Adjacent posts">
          {prev ? (
            <a class="prev" href={prev.href}>
              ← <span>{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="next" href={next.href}>
              <span>{next.data.title}</span> →
            </a>
          )}
        </nav>
      )
    }
  </main>
</Base>

<style>
  .post-page {
    max-width: 604px;
  }
  .back {
    display: inline-block;
    margin: 0 0 40px;
    font: 400 12px/1 var(--mono);
    color: var(--mut);
  }
  .back:hover {
    color: var(--ink);
  }
  .meta {
    font: 400 12px/1.6 var(--mono);
    color: var(--faint);
  }
  h1 {
    margin: 10px 0 0;
    font: 600 30px/1.22 var(--serif);
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0 0;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }
  .tags.none {
    margin-top: 0;
    padding-bottom: 24px;
  }
  .tag {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 3px;
    font: 400 11px/1.4 var(--mono);
    color: var(--mut);
  }
  .tag:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .lede {
    margin: 30px 0 0;
    font: 400 17px/1.65 var(--serif);
    color: var(--ink);
  }
  .prose {
    margin-top: 22px;
  }

  .pager {
    margin: 56px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font: 400 12.5px/1.6 var(--mono);
  }
  .pager a {
    flex: 1;
    color: var(--mut);
  }
  .pager a span {
    color: var(--ink);
  }
  .pager a:hover,
  .pager a:hover span {
    color: var(--ink);
  }
  .pager .next {
    text-align: right;
  }
</style>
